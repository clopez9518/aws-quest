# ==============================================================================
# AWS Architecture Quest - Configuración de Entorno (Local y Producción)
# ==============================================================================

# Entorno de Ejecución
NODE_ENV=production
ASPNETCORE_ENVIRONMENT=Production

# Puertos Expuestos en Host (Desarrollo Local / Docker Compose)
WEB_PORT=3000
API_PORT=8080
POSTGRES_PORT=5437

# Base de Datos PostgreSQL Local
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=awsquest_db

# Base de Datos PostgreSQL Producción (Neon Serverless)
# ConnectionStrings__DefaultConnection=Host=ep-xyz.us-east-2.aws.neon.tech;Port=5432;Database=neondb;Username=neondb_owner;Password=***;SslMode=Require;Trust Server Certificate=true;Include Error Detail=false;

# Seguridad JWT (.NET 10 Backend - Mínimo 32 caracteres)
JWT_SECRET=ChangeThisToAStrongRandom64CharSecretKeyInProduction1234567890!
JWT_ISSUER=AwsQuestApi
JWT_AUDIENCE=AwsQuestClient
JWT_EXPIRATION_HOURS=24
JWT_GUEST_EXPIRATION_DAYS=30

# CORS Producción (Render Backend -> Dominio de Vercel)
# CorsSettings__AllowedOrigins__0=https://aws-game.vercel.app

# Frontend Vercel (Build Time)
# VITE_API_BASE_URL=https://aws-game-api.onrender.com/api/v1
