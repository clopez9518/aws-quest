  "hints": [
    {
      "orderIndex": 1,
      "text": "¿Cómo construyes una aplicación moderna donde el frontend esté en el Edge y el backend sea completamente event-driven sin servidores que mantener?",
      "penaltyPoints": 5
    },
    {
      "orderIndex": 2,
      "text": "Combina una SPA en S3 con CDN CloudFront y una API serverless respaldada por Lambda, EventBridge y DynamoDB.",
      "penaltyPoints": 10
    },
    {
      "orderIndex": 3,
      "text": "Conecta CloudFront a S3, API Gateway a Lambda, Lambda emitiendo eventos a EventBridge y Lambda persistiendo en DynamoDB.",
      "penaltyPoints": 15
    },
    {
      "orderIndex": 4,
      "text": "Une CloudFront con S3 (CDN_ORIGIN), API Gateway con Lambda (LAMBDA_PROXY), Lambda con EventBridge (EVENT_NOTIFICATION) y Lambda con DynamoDB (DATABASE_QUERY).",
      "penaltyPoints": 20
    }
  ],
