    {
      "name": "05 - Escenarios de Error 409 Conflict",
      "item": [
        {
          "name": "POST /api/v1/auth/register — Email Duplicado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"duplicado@awsquest.dev\",\n  \"password\": \"Password123!\",\n  \"name\": \"Usuario Duplicado\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 409 Conflict o 201 Created (primer registro)\", function () {",
                  "    pm.expect([201, 409]).to.include(pm.response.code);",
                  "});",
                  "",
                  "if (pm.response.code === 409) {",
                  "    pm.test(\"Error code is EMAIL_ALREADY_EXISTS\", function () {",
                  "        var res = pm.response.json();",
                  "        pm.expect(res.success).to.be.false;",
                  "        pm.expect(res.error.code).to.eql(\"EMAIL_ALREADY_EXISTS\");",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
