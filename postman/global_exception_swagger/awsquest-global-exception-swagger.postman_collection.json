{
  "info": {
    "_postman_id": "c928419a-41ab-4dc9-9830-10492e71d34c",
    "name": "AWS Architecture Quest - 06 Global Exception & Swagger",
    "description": "Colección de pruebas para validar la documentación interactiva Swagger/OpenAPI y el manejo homogéneo de excepciones y errores canónicos en la API REST de AWS Architecture Quest.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 - Documentación Swagger y OpenAPI",
      "item": [
        {
          "name": "GET /swagger/v1/swagger.json — Especificación OpenAPI / Swagger",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/swagger/v1/swagger.json",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "swagger",
                "v1",
                "swagger.json"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Swagger JSON contains title and Bearer security\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.info.title).to.include(\"AWS Architecture Quest API\");",
                  "    pm.expect(jsonData.components.securitySchemes).to.have.property(\"Bearer\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /swagger/index.html — Interfaz Swagger UI",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/swagger/index.html",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "swagger",
                "index.html"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Swagger UI HTML is returned\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/html\");",
                  "    pm.expect(pm.response.text()).to.include(\"Swagger UI\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 - Escenarios de Error 400 Bad Request",
      "item": [
        {
          "name": "POST /api/v1/auth/register — Error de Validación (Campos Inválidos)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"email-no-valido\",\n  \"password\": \"123\",\n  \"name\": \"\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"Validation error envelope is well-structured\", function () {",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.success).to.be.false;",
                  "    pm.expect(res.error.code).to.eql(\"VALIDATION_ERROR\");",
                  "    pm.expect(res.error.details).to.be.an(\"array\");",
                  "    pm.expect(res.error.details.length).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST /api/v1/challenges/{id}/evaluate — Error Grafo Inválido (Array Vacío)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"graph\": {\n    \"components\": []\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/challenges/11111111-1111-1111-1111-111111111111/evaluate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "challenges",
                "11111111-1111-1111-1111-111111111111",
                "evaluate"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"Error code is VALIDATION_ERROR or INVALID_GRAPH_PAYLOAD\", function () {",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.success).to.be.false;",
                  "    pm.expect([\"VALIDATION_ERROR\", \"INVALID_GRAPH_PAYLOAD\"]).to.include(res.error.code);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "PATCH /api/v1/system/config — Error Tipo de Acceso Inválido",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accessMode\": \"ValorInvalidoDeEnum\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/system/config",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "system",
                "config"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"Error code is VALIDATION_ERROR\", function () {",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.success).to.be.false;",
                  "    pm.expect(res.error.code).to.eql(\"VALIDATION_ERROR\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Escenarios de Error 401 Unauthorized",
      "item": [
